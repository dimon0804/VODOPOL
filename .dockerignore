# Всё, что не должно попасть в образ.

# Данные и артефакты монтируются, а не собираются внутрь.
data/
outputs/
models/
reports/

# splits/ здесь быть НЕ должно: Dockerfile копирует его в образ (COPY splits/ splits/),
# и с исключением сборка падает на этом шаге. Это манифест выборок, несколько
# килобайт текста, а не данные.

# Локальное окружение
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# История и служебное
.git/
.github/
.gitignore
.vscode/
.idea/

# Документация и тесты в рантайме не нужны
docs/
tests/
CLAUDE.md
