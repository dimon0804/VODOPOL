__pycache__/
*.py[cod]
.venv/
venv/
.env

# Исходный набор данных в репозиторий не кладём — он берётся из официального бакета
data/cache/
data/raw/
*.tif

# Но эталонные комплекты запусков нужны жюри целиком, вместе с растрами
!outputs/**/*.tif

reports/_*.log
.playwright-mcp/
.DS_Store
Thumbs.db

# Windows плодит копии вида «файл (2).json» при повторном сохранении.
# В комплекте им не место: валидатор их игнорирует, а жюри увидит мусор.
*\ (2).*
*" (2)".*
